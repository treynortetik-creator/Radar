{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "nixpacksConfigPath": "dashboard/nixpacks.toml",
    "watchPatterns": ["dashboard/**"]
  },
  "deploy": {
    "startCommand": "cd dashboard && npm start",
    "healthcheckPath": "/",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}