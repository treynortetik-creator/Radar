# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase service role key (server-side only, never expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# OpenRouter API key for AI scoring (server-side only)
OPENROUTER_API_KEY=your-openrouter-key-here

# Ingest API secret (protect the /api/ingest endpoint from unauthorized calls)
# Generate with: openssl rand -hex 32
INGEST_API_SECRET=your-ingest-secret-here

# Slack integration (optional — digest will skip Slack post if not set)
# Create a Slack app at https://api.slack.com/apps, add chat:write scope, install to workspace
SLACK_BOT_TOKEN=xoxb-your-bot-token-here
# Channel ID (not name) — right-click channel in Slack > "Copy link", ID is the last segment
SLACK_INTEL_CHANNEL_ID=C0XXXXXXXXX

# Deployment (optional, auto-detected on Railway/Vercel)
# RAILWAY_PUBLIC_DOMAIN=your-app.up.railway.app
# VERCEL_URL=your-app.vercel.app
